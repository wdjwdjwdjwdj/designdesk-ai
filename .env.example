# Copy to .env and fill in. Every value is optional — without them the app
# runs fully in demo mode (programmatic drafts + simulated checkout).

# --- PayPal sandbox (https://developer.paypal.com → Apps & Credentials → Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# --- AI image generation (any OpenAI-compatible Images API) ---
IMAGE_API_KEY=
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1

# --- Server ---
PORT=3000
# Public base URL used for PayPal return/cancel redirects (e.g. your tunnel or deploy URL).
PUBLIC_BASE_URL=http://localhost:3000
